# Scratch buffer `edit` opens (Tempfile 'pry*.rb'): wipe diagnostics as they arrive. enable(false)
# only hides display; Trouble still lists them. Real files keep diagnostics.
NO_DIAGNOSTICS = "lua vim.api.nvim_create_autocmd('DiagnosticChanged', {buffer = 0, " \
                 "callback = function(a) if #vim.diagnostic.get(a.buf) > 0 then vim.diagnostic.reset(nil, a.buf) end end})"
Pry.config.editor = proc do |file, line|
  scratch = File.basename(file).match?(/\Apry.*\.rb\z/) && file.start_with?(Dir.tmpdir, File.realpath(Dir.tmpdir))
  "sl #{%(-c "#{NO_DIAGNOSTICS}") if scratch} +#{line} #{Shellwords.escape(file)}"
end

