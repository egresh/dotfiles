<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps OmniShell's layout-mode widget (shell/widgets/layout) current: OmniShell
  gives bar widgets no layout data, so push.sh queries OmniWM and pushes it in
  (and whether the focused window floats) whenever focus, a window, a
  workspace layout or the active workspace changes.
  Loaded by bootstrap.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.omnishell.layout</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec /opt/homebrew/bin/omniwmctl watch focus,windows-changed,layout-changed,active-workspace --reconnect --exec "$HOME/.config/omniwm/shell/widgets/layout/push.sh"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardErrorPath</key>
  <string>/tmp/omnishell-layout.log</string>
</dict>
</plist>
